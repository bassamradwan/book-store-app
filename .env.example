PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/book-store
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Used to build the password reset link
APP_URL=http://localhost:5000

# Optional: an SMTP server to email password reset links.
# Without SMTP_HOST, the link is printed in the server console (local development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
